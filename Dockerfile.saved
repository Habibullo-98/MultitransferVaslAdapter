FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY . .
RUN dotnet restore ./src/MultitransferVaslAdapter/MultitransferVaslAdapter.csproj
RUN dotnet publish ./src/MultitransferVaslAdapter/MultitransferVaslAdapter.csproj -c Release -o /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
WORKDIR /app
ENV ASPNETCORE_URLS=http://+:8088
EXPOSE 8088
COPY --from=build /app/publish .
ENTRYPOINT ["dotnet","MultitransferVaslAdapter.dll"]
